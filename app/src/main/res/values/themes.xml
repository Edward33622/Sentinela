<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sentinela" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sentinela_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sentinela_dark_green</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.Sentinela.Green">
        <item name="android:windowBackground">@color/sentinela_dark_green</item>
        <item name="android:statusBarColor">@color/sentinela_dark_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/sentinela_dark_green</item>
    </style>

    <style name="Theme.Sentinela.Grouped">
        <item name="android:windowBackground">@color/system_gray6</item>
        <item name="android:statusBarColor">@color/system_gray6</item>
        <item name="android:navigationBarColor">@color/system_gray6</item>
    </style>

    <style name="Theme.Sentinela.History">
        <item name="android:windowBackground">@color/sentinela_history_bg</item>
        <item name="android:statusBarColor">@color/sentinela_history_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/sentinela_history_bg</item>
    </style>

    <style name="Sentinela.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Campo de texto translúcido de Login / Registro -->
    <style name="Sentinela.AuthField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_marginStart">50dp</item>
        <item name="android:layout_marginEnd">50dp</item>
        <item name="android:background">@drawable/bg_field_translucent</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">#8C3C3C43</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Botón "filled" de iOS -->
    <style name="Sentinela.FilledButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/sentinela_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Sentinela.PlainButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
