<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sentinela_notice"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/noticeIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="✓"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/noticeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="Listo"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/noticeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="La acción se completó correctamente."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/noticePrimary"
        style="@style/Sentinela.FilledButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:text="Continuar"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/noticeSecondary"
        style="@style/Sentinela.PlainButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text=""
        android:textColor="@color/text_brand"
        android:visibility="gone" />
</LinearLayout>
