<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Degradado suave superior e inferior para legibilidad de botones (sin opacar el mapa) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_map_scrim" />

    <!-- Barra superior de botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnConfiguracion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Configuración"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_brand" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnAsistenteIa"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Asistente Sentinela IA"
            android:src="@drawable/ic_sparkle_ai" />

        <ImageButton
            android:id="@+id/btnTrayectoSeguro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Trayecto Seguro"
            android:src="@drawable/ic_safe_trip" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/btnHistorial"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Historial de Alertas"
                android:src="@drawable/ic_history" />

            <TextView
                android:id="@+id/badgeHistorial"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_circle_red"
                android:gravity="center"
                android:textColor="@color/text_on_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Perfil"
            android:src="@drawable/ic_person"
            android:tint="@color/text_brand" />
    </LinearLayout>

    <!-- Card flotante de Estado de Seguridad en tiempo real (Mejora #4) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEstadoSeguridad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        app:cardBackgroundColor="@color/surface_secondary"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp">

            <View
                android:id="@+id/dotEstadoSeguridad"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_circle_green" />

            <TextView
                android:id="@+id/lblEstadoSeguridad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Sentinela Activo"
                android:textColor="@color/text_brand"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/outline" />

            <TextView
                android:id="@+id/lblCuotaIa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="IA: 4/4"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardEstadoMapa"
        style="@style/Sentinela.MapCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="24dp"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblEstadoGps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:drawablePadding="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:drawableStart="@drawable/ic_my_location"
                    android:drawableTint="@color/text_brand"
                    android:text="Buscando ubicación…"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lblEstadoRed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="Comprobando red…"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblDestinoMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sin trayecto seleccionado"
                    android:textAppearance="@style/TextAppearance.Sentinela.Body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblEstadoRuta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityLiveRegion="polite"
                android:text="El estado de la ruta aparecerá aquí"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Banner flotante de Trayecto Seguro activo (CU05) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bannerTrayecto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="204dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/sentinela_dark_green"
        app:cardCornerRadius="@dimen/radius_button"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription=""
                android:src="@drawable/ic_safe_trip"
                android:tint="@color/text_on_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTimerTrayecto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Trayecto: 15:00 restante"
                    android:textColor="@color/text_on_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lblDestinoTrayecto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Destino seleccionado"
                    android:textColor="@color/text_on_accent"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalizarTrayecto"
                style="@style/Sentinela.SuccessActionButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="92dp"
                android:contentDescription="Confirmar que llegué a salvo y finalizar el trayecto"
                android:text="Llegué"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="@color/sentinela_dark_green" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botón flotante para activar/ocultar Puntos de Ayuda y Zonas de Riesgo (Prevención Activa) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCapaSeguridad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="438dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Zonas de Riesgo y Comisarías"
        android:src="@drawable/ic_shield"
        app:backgroundTint="@color/surface_primary"
        app:fabCustomSize="48dp"
        app:maxImageSize="24dp"
        app:tint="@color/text_brand"
        app:elevation="4dp" />

    <!-- Botón flotante para cambiar estilo de mapa (Modo Diurno / Nocturno Táctico) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnEstiloMapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="382dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Cambiar estilo de mapa"
        android:src="@drawable/ic_layers"
        app:backgroundTint="@color/surface_primary"
        app:fabCustomSize="48dp"
        app:maxImageSize="24dp"
        app:tint="@color/text_secondary"
        app:elevation="4dp" />

    <!-- Botón flotante para centrar en Mi Ubicación actual -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="326dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Centrar en mi ubicación actual"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/surface_primary"
        app:fabCustomSize="48dp"
        app:maxImageSize="24dp"
        app:tint="@color/text_success"
        app:elevation="4dp" />

    <!-- Botones flotantes de acción rápida: Llamada Falsa y SOS Perú -->
    <LinearLayout
        android:id="@+id/panelAccionesRapidas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="266dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFamilia"
            style="@style/Sentinela.CompactActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Familia"
            android:textColor="@color/text_brand"
            android:textSize="12sp"
            app:backgroundTint="@color/surface_primary"
            app:cornerRadius="24dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_family"
            app:iconTint="@color/text_brand"
            app:iconPadding="4dp"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLlamadaFalsa"
            style="@style/Sentinela.CompactActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Llamada"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:backgroundTint="@color/surface_primary"
            app:cornerRadius="24dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_call"
            app:iconTint="@color/text_primary"
            app:iconPadding="4dp"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSosCentrales"
            style="@style/Sentinela.CompactActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="SOS (105)"
            android:textColor="@color/text_error"
            android:textSize="12sp"
            app:backgroundTint="@color/surface_primary"
            app:cornerRadius="24dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_warning"
            app:iconTint="@color/text_error"
            app:iconPadding="4dp"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Panel inferior -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="254dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_panel"
        android:clickable="true"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/panelHandle"
            android:layout_width="match_parent"
            android:layout_height="21dp">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_handle" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Contactos"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAgregarContacto"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_green"
                android:contentDescription="Agregar contacto"
                android:src="@drawable/ic_add" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelContactos"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDesactivar"
                style="@style/Sentinela.DangerActionButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:contentDescription="Activar alerta SOS de emergencia"
                android:text="ACTIVAR SOS"
                app:icon="@drawable/ic_warning"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoDiscreto"
            style="@style/Sentinela.CompactActionButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Modo Discreto"
                android:textColor="@color/chip_green_text"
                android:textSize="17sp"
                app:backgroundTint="@color/chip_green_bg"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
