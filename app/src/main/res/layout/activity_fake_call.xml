<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- Datos del llamante -->
    <LinearLayout
        android:id="@+id/layoutCallerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Avatar circular grande -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_circle_avatar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="👤"
                android:textSize="56sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Mamá"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:text="Llamada entrante..."
            android:textColor="#94A3B8"
            android:textSize="18sp" />

        <!-- Cronómetro activo de llamada -->
        <Chronometer
            android:id="@+id/chronometerCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#10B981"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Opciones durante la llamada (Altavoz, Silenciar, Teclado) -->
    <LinearLayout
        android:id="@+id/layoutInCallOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_field_translucent"
                android:padding="16dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Silenciar"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_field_translucent"
                android:padding="16dp"
                android:src="@drawable/ic_person"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Altavoz"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones de estado ENTRANTE (Rechazar / Contestar) -->
    <LinearLayout
        android:id="@+id/layoutIncomingButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Rechazar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="64dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDeclineCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Rechazar"
                android:src="@drawable/ic_call_end"
                app:backgroundTint="#EF4444"
                app:fabCustomSize="72dp"
                app:maxImageSize="36dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rechazar"
                android:textColor="#EF4444"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Contestar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAcceptCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Contestar"
                android:src="@drawable/ic_call"
                app:backgroundTint="#10B981"
                app:fabCustomSize="72dp"
                app:maxImageSize="36dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Contestar"
                android:textColor="#10B981"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón de COLGAR cuando ya está en llamada -->
    <LinearLayout
        android:id="@+id/layoutHangupButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnHangUpCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Finalizar llamada"
            android:src="@drawable/ic_call_end"
            app:backgroundTint="#EF4444"
            app:fabCustomSize="72dp"
            app:maxImageSize="36dp"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Finalizar"
            android:textColor="#EF4444"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>
