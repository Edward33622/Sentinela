<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 fuerza edge-to-edge; lo desactivamos para conservar las barras de color -->
    <style name="Theme.Sentinela" parent="Base.Theme.Sentinela">
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowAnimationStyle">@style/Sentinela.WindowAnimation</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
